{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": [
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "AUTH_DEV_ORIGINS",
    "AUTH_DEV_PROXY_URL",
    "AUTH_SECRET",
    "CRON_SECRET",
    "OPENAI_API_KEY",
    "OPENAI_API_URL",
    "PORT",
    "POSTGRES_SSL_MODE",
    "POSTGRES_URL",
    "PUBLIC_WEB_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_PORT",
    "STRIPE_WEBHOOK_SECRET",
    "VERCEL_BRANCH_URL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "WORKFLOW_TARGET_WORLD",
    "WORKFLOW_LOCAL_DATA_DIR"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "npm_lifecycle_event",
    "VERCEL_DEPLOYMENT_ID"
  ],
  "tasks": {
    "@acme/component-review#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../web/src/app/styles.css",
        "../web/src/app/fonts/**",
        "../web/src/components/brand.tsx",
        "../web/public/brand/**"
      ],
      "outputs": ["dist/**"]
    },
    "@acme/component-review#test:browser": {
      "cache": false,
      "passThroughEnv": ["COMPONENT_REVIEW_URL", "PLAYWRIGHT_*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "check": {
      "dependsOn": ["^topo"],
      "outputLogs": "new-only"
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "shadcn": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "test:browser": {
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*", "PLAYWRIGHT_*"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "test:stories": {
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["^topo"]
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["^topo"]
    }
  },
  "ui": "tui"
}
