{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-editor-registry.mjs"
      ],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts", "public/r/**"]
    },
    "dev": {
      "persistent": true
    }
  }
}
